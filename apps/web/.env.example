# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/snapbug

# Cloudflare R2
ACCESS_KEY_ID=your-access-key-id-here
SECRET_ACCESS_KEY=your-secret-access-key-here
ACCOUNT_ID=your-account-id-here
BUCKET_NAME=your-bucket-name-here

# Snapbug
SNAPBUG_TEST_API_KEY=your-snapbug-test-api-key-here

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PLAYGROUND_URL=http://localhost:3001
AUTH_SECRET=your-secret-auth-secret

# Resend
RESEND_API_KEY=your-resend-api-key-here
EMAIL_FROM=noreply@snapbug.com
# EMAIL_TRANSPORT=log ["log", "resend" (default)]