{
  "extends": "@workspace/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@workspace/server/modules/*": ["../../packages/server/src/modules/*"],
      "@workspace/server/shared/*": ["../../packages/server/src/shared/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "src/shared/auth/next-auth.d.ts"
  ],
  "exclude": ["node_modules"]
}
